{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@salonomia/auth": ["packages/auth/src/index.ts"],
      "@salonomia/contracts": ["packages/contracts/src/index.ts"],
      "@salonomia/database": ["packages/database/src/index.ts"],
      "@salonomia/storage": ["packages/storage/src/index.ts"],
      "@salonomia/validation": ["packages/validation/src/index.ts"]
    }
  },
  "exclude": ["node_modules", ".next"]
}
