{
  "version": 2,
  "builds": [
    {
      "src": "apps/web/next.config.ts",
      "use": "@vercel/next"
    },
    {
      "src": "apps/api/src/vercel.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["packages/database/prisma/schema.prisma"]
      }
    }
  ],
  "routes": [
    {
      "src": "/public/(.*)",
      "dest": "apps/api/src/vercel.ts"
    },
    {
      "src": "/auth/(.*)",
      "dest": "apps/api/src/vercel.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "apps/api/src/vercel.ts"
    },
    {
      "src": "/(.*)",
      "dest": "apps/web/next.config.ts"
    }
  ]
}
