# Copy to .env and fill in real values. Never commit .env.

# apps/api
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://salonomia:salonomia@localhost:5432/salonomia
SESSION_SECRET=replace-with-a-long-random-string

# File storage (see docs/adr/0008-file-storage.md). STORAGE_DRIVER defaults to "local" (no
# Docker/S3 in this environment). Set STORAGE_DRIVER=s3 and the S3_* vars below in production.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.local-storage
LOCAL_STORAGE_SIGNING_SECRET=replace-with-a-long-random-string
LOCAL_STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# apps/web / apps/dashboard
NEXT_PUBLIC_API_URL=http://localhost:4000

# apps/dashboard — used to build the manual invitation link shown after creating a salon
# (no email delivery provider exists yet, see docs/security/authentication.md)
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
