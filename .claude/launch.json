{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@salonomia/api", "dev"],
      "port": 4000
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@salonomia/dashboard", "dev"],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@salonomia/web", "dev"],
      "port": 3000
    },
    {
      "name": "web-local",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "apps/web", "exec", "next", "dev", "--port", "3100"],
      "port": 3100
    }
  ]
}
